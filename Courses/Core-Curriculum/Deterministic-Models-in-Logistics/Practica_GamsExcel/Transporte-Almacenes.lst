G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


   1  * ==============================================================
   2  *  PROBLEMA TRANSPORTE–ALMACENES
   3  *  (Modelo de localización con costes fijos y transporte)
   4  * ==============================================================
   5   
   6  * ---------- Conjuntos ----------
   7  SETS
   8      i "Almacenes potenciales" /A1, A2, A3/
   9      j "Clientes"              /C1, C2/;
  10   
  11  * ---------- Parámetros ----------
  12  PARAMETERS
  13      ci(i)    "Capacidad del almacén i"
  14      dj(j)    "Demanda del cliente j"
  15      fi(i)   "Coste fijo de apertura del almacén i"
  16      bij(i,j) "Coste unitario de transporte desde i a j";
  17   
  18  * ---------- Tabla de costes de transporte ----------
  19  TABLE bij(i,j) "Coste unitario de transporte desde i a j"
  20           C1     C2
  21     A1    1.5    2
  22     A2    2      1.5
  23     A3    2.5    2.25;
  24   
  25  * ---------- Tablas de datos ----------
  26  TABLE capData(i,*) "Capacidades de los almacenes"
  27           valor
  28      A1    4000
  29      A2    5000
  30      A3    6000;
  31   
  32  TABLE demandData(j,*) "Demandas de los clientes"
  33           valor
  34      C1    3000
  35      C2    5000;
  36   
  37  TABLE costData(i,*) "Costes fijos de apertura de almacenes"
  38           valor
  39      A1    8000
  40      A2    12000
  41      A3    7000;
  42   
  43  * ---------- Asignación automática ----------
  44  ci(i)  = capData(i,"valor");
  45  dj(j)  = demandData(j,"valor");
  46  fi(i) = costData(i,"valor");
  47   
  48  * ---------- Variables ----------
  49  VARIABLES
  50      Yij(i,j) "Cantidad enviada desde el almacén i al cliente j"
  51      Xi(i)    "Variable binaria: 1 si el almacén i se abre, 0 si no"
  52      z        "Costo total (transporte + costes fijos)";
  53   
  54  POSITIVE VARIABLES Yij;
  55  BINARY VARIABLES Xi;
  56   
  57  * ---------- Ecuaciones ----------
  58  EQUATIONS
  59      funObj       "Función objetivo: minimizar costes totales"
  60      capConstr(i) "Restricción de capacidad y apertura"
  61      demConstr(j) "Restricción de satisfacción de demanda";
  62   
  63  * ---------- Función objetivo ----------
  64  funObj..
  65      z =E= SUM((i,j), bij(i,j) * Yij(i,j)) + SUM(i, fi(i) * Xi(i));
  66   
  67  * ---------- Restricciones ----------
  68   
  69  * Un almacén solo puede enviar si está abierto y no puede superar su capacidad
  70  capConstr(i)..
  71      SUM(j, Yij(i,j)) =L= ci(i) * Xi(i);
  72   
  73  * Cada cliente debe recibir exactamente su demanda
  74  demConstr(j)..
  75      SUM(i, Yij(i,j)) =E= dj(j);
  76   
  77  * ---------- Modelo ----------
  78  MODEL Transporte_Almacenes /all/;
  79   
  80  * ---------- Resolver ----------
  81  SOLVE Transporte_Almacenes USING MIP MINIMIZING z;
  82   
  83  * ---------- Mostrar resultados ----------
  84  DISPLAY Xi.l, Yij.l, z.l Yij.lo, Yij.up
  85   
  86   


