G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


   1  * ================================
   2  *   PROBLEMA TRANSPORTE
   3  * ================================
   4   
   5  * ---------- Conjuntos ----------
   6  SETS
   7      i "Almacenes" /A1, A2, A3/
   8      j "Clientes"  /C1, C2/;
   9   
  10  * ---------- Parámetros ----------
  11  PARAMETERS
  12      ci(i)     "Capacidad del almacén i"
  13      dj(j)     "Demanda del cliente j"
  14      bij(i,j)  "Coste de transporte de una unidad desde i a j";
  15   
  16  * ---------- Tabla de costos de transporte ----------
  17  TABLE bij(i,j) "Coste de transporte de una unidad desde i a j"
  18           C1    C2
  19      A1   1.5   2
  20      A2   2     1.5
  21      A3   2.5   2.25;
  22   
  23  * ---------- Tablas de datos automáticas ----------
  24  TABLE data(i,*) "Capacidades de almacenes"
  25           valor
  26      A1    4000
  27      A2    5000
  28      A3    6000;
  29   
  30  TABLE demand(j,*) "Demandas de los clientes"
  31           valor
  32      C1    3000
  33      C2    5000;
  34   
  35  * ---------- Asignación automática ----------
  36  ci(i) = data(i,"valor");
  37  dj(j) = demand(j,"valor");
  38   
  39  * ---------- Variables ----------
  40  VARIABLES
  41      Yij(i,j) "Cantidad enviada desde el almacén i al cliente j"
  42      z        "Costo total de transporte";
  43   
  44  POSITIVE VARIABLES Yij;
  45   
  46  * ---------- Ecuaciones ----------
  47  EQUATIONS
  48      funObj       "Función objetivo: minimizar costo total"
  49      capConstr(i) "Restricción de capacidad de cada almacén"
  50      demConstr(j) "Restricción de satisfacción de demanda de cada cliente";
  51   
  52  * ---------- Función objetivo ----------
  53  funObj..
  54      z =E= SUM((i,j), bij(i,j) * Yij(i,j));
  55   
  56  * ---------- Restricciones ----------
  57  capConstr(i)..
  58      SUM(j, Yij(i,j)) =L= ci(i);
  59   
  60  demConstr(j)..
  61      SUM(i, Yij(i,j)) =G= dj(j);
  62   
  63  * ---------- Modelo ----------
  64  MODEL Transporte /all/;
  65   
  66  * ---------- Resolver ----------
  67  SOLVE Transporte USING LP MINIMIZING z;
  68   
  69  * ---------- Mostrar resultados ----------
  70  DISPLAY Yij.l, z.l, capConstr.m, demConstr.m;


